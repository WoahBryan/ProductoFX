<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.productofx.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <TableView fx:id="tvProduct" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="tcName" prefWidth="75.0" text="Name" />
          <TableColumn fx:id="tcPrice" prefWidth="75.0" text="Price" />
            <TableColumn fx:id="tcQuantity" prefWidth="75.0" text="Quantity" />
            <TableColumn fx:id="tcMarca" prefWidth="75.0" text="Marca" />
        </columns>
      </TableView>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <TextField fx:id="tfName" promptText="Name" />
            <TextField fx:id="tfPrice" promptText="Price" />
            <TextField fx:id="tfQuantity" promptText="Quantity" />
            <TextField fx:id="tfMarca" promptText="Marca" />
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleBtnAdd" text="Add" />
            <Button mnemonicParsing="false" onAction="#handleBtnReset" text="Reset" />
            <Button mnemonicParsing="false" onAction="#handleBtnDel" text="Del" />
         </children>
      </HBox>
   </children>
</VBox>
